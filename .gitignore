# Byte-compiled / cache
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# Packaging metadata regenerated by `pip install -e .`
*.egg-info/
build/
dist/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Stray CBC/PuLP run artifacts dropped by keepFiles=True into whichever
# directory zero_depot.py was invoked from - the repo root or src/.
*-pulp.mps
*-pulp.sol
*-pulp.lp

# ...except the two exports kept deliberately for inspection.
!PuLP_solver_files/fleet_min-pulp.mps
!src/fleet_min-pulp.sol

# Editor / OS
.vscode/*
# ...except the shared workspace config, which is what puts the repo root on
# sys.path for a fresh clone. Both files are checked in deliberately.
!.vscode/settings.json
!.vscode/.env
.idea/
.DS_Store
Thumbs.db
