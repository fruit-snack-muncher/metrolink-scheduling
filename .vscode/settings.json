{
  // Puts the repo root on sys.path for the Run button and the debugger, on
  // every platform. VS Code expands ${workspaceFolder} inside the .env file.
  "python.envFile": "${workspaceFolder}/.vscode/.env",

  // The same path for Pylance, which reads neither .env nor the editable
  // install - without this, every `from src...` import is a red squiggle.
  "python.analysis.extraPaths": ["${workspaceFolder}"],

  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.pytestArgs": ["tests"]
}
